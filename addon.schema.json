{
	"$schema": "http://json-schema.org/draft-07/schema#",
	"$id": "https://regletto.com/developers/addon.schema.json",
	"title": "addon.json",
	"description": "The core of addon.json, what every Regletto product reads the same. Each product SDK ships the whole schema of its product, made from this one. https://regletto.com/developers",
	"type": "object",
	"required": ["id", "title", "description", "version", "author", "engines", "icon", "needs"],
	"additionalProperties": false,
	"properties": {
		"$schema": {
			"description": "Where your editor finds this schema. The product ignores the field."
		},
		"id": {
			"description": "<publisher>.<name>, for example regletto.schreibziel. Both parts are 2 to 64 of a to z, 0 to 9 and -, the whole at most 64 characters. Never shown, it names the folder.",
			"type": "string",
			"pattern": "^(?=.{5,64}$)(?!.*\\.part$)(?!(?:con|prn|aux|nul|com[0-9]|lpt[0-9])\\.)[a-z0-9][a-z0-9-]{1,63}\\.[a-z0-9][a-z0-9-]{1,63}$"
		},
		"title": {
			"description": "The name on the card, 1 to 40 characters with a letter or a digit. A string, or one per language: { \"de\": \"Figuren\", \"en\": \"Characters\" }.",
			"$ref": "#/$defs/title"
		},
		"description": {
			"description": "One sentence on the card, 1 to 200 characters. A string, or one per language.",
			"$ref": "#/$defs/line200"
		},
		"version": {
			"description": "major.minor.patch, compared when updating.",
			"type": "string",
			"pattern": "^\\d+\\.\\d+\\.\\d+$"
		},
		"author": {
			"description": "Who made it, on the card. 1 to 60 characters.",
			"$ref": "#/$defs/one60"
		},
		"engines": {
			"description": "From which version of each product it runs: { \"<product>\": \">=1.0.0\" }.",
			"type": "object",
			"minProperties": 1,
			"propertyNames": { "pattern": "^[a-z][a-z0-9-]{1,19}$" },
			"additionalProperties": { "type": "string", "pattern": "^>=\\d+\\.\\d+\\.\\d+$" }
		},
		"icon": {
			"description": "A name from Material Symbols Rounded, for example flag.",
			"type": "string",
			"pattern": "^[a-z0-9_]{1,40}$"
		},
		"needs": {
			"description": "What the add-on may do. store, settings, log, theme and lang need nothing.",
			"type": "array",
			"items": {
				"enum": ["workspace"],
				"markdownEnumDescriptions": [
					"A workspace behind its own icon in the rail. Needs addon.js."
				]
			}
		},
		"settings": {
			"description": "What the author can set, at most 40 rows. The product draws them; the add-on reads them with addon.settings().",
			"type": "array",
			"minItems": 1,
			"maxItems": 40,
			"items": { "$ref": "#/$defs/row" }
		}
	},
	"$defs": {
		"one40": {
			"type": "string",
			"minLength": 1,
			"maxLength": 40,
			"pattern": "^(?!\\s*$)[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}]*$"
		},
		"one60": {
			"type": "string",
			"minLength": 1,
			"maxLength": 60,
			"pattern": "^(?!\\s*$)[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}]*$"
		},
		"one200": {
			"type": "string",
			"minLength": 1,
			"maxLength": 200,
			"pattern": "^(?!\\s*$)[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}]*$"
		},
		"titleOne": {
			"type": "string",
			"minLength": 1,
			"maxLength": 40,
			"pattern": "^(?!\\s*$)(?=.*[\\p{L}\\p{N}])[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}]*$"
		},
		"title": {
			"oneOf": [
				{ "$ref": "#/$defs/titleOne" },
				{
					"type": "object",
					"minProperties": 1,
					"propertyNames": { "pattern": "^[a-z]{2}$" },
					"additionalProperties": { "$ref": "#/$defs/titleOne" }
				}
			]
		},
		"line40": {
			"oneOf": [
				{ "$ref": "#/$defs/one40" },
				{
					"type": "object",
					"minProperties": 1,
					"propertyNames": { "pattern": "^[a-z]{2}$" },
					"additionalProperties": { "$ref": "#/$defs/one40" }
				}
			]
		},
		"line60": {
			"oneOf": [
				{ "$ref": "#/$defs/one60" },
				{
					"type": "object",
					"minProperties": 1,
					"propertyNames": { "pattern": "^[a-z]{2}$" },
					"additionalProperties": { "$ref": "#/$defs/one60" }
				}
			]
		},
		"line200": {
			"oneOf": [
				{ "$ref": "#/$defs/one200" },
				{
					"type": "object",
					"minProperties": 1,
					"propertyNames": { "pattern": "^[a-z]{2}$" },
					"additionalProperties": { "$ref": "#/$defs/one200" }
				}
			]
		},
		"rowId": {
			"description": "The key in addon.settings(), unique in the list.",
			"type": "string",
			"pattern": "^[A-Za-z0-9_-]{1,40}$"
		},
		"option": {
			"type": "object",
			"required": ["value", "label"],
			"additionalProperties": false,
			"properties": {
				"value": { "type": "string", "pattern": "^[A-Za-z0-9_-]{1,40}$" },
				"label": { "$ref": "#/$defs/line40" }
			}
		},
		"row": {
			"type": "object",
			"required": ["id", "type", "label", "default"],
			"properties": {
				"type": {
					"description": "switch, segment, select, number or text.",
					"enum": ["switch", "segment", "select", "number", "text"]
				}
			},
			"oneOf": [
				{
					"properties": {
						"id": { "$ref": "#/$defs/rowId" },
						"group": { "$ref": "#/$defs/line40" },
						"label": { "$ref": "#/$defs/line60" },
						"hint": { "$ref": "#/$defs/line200" },
						"first": { "type": "boolean" },
						"type": { "const": "switch" },
						"default": { "type": "boolean" }
					},
					"additionalProperties": false
				},
				{
					"required": ["options"],
					"properties": {
						"id": { "$ref": "#/$defs/rowId" },
						"group": { "$ref": "#/$defs/line40" },
						"label": { "$ref": "#/$defs/line60" },
						"hint": { "$ref": "#/$defs/line200" },
						"first": { "type": "boolean" },
						"type": { "const": "segment" },
						"options": { "type": "array", "minItems": 2, "maxItems": 4, "items": { "$ref": "#/$defs/option" } },
						"default": { "description": "The value of one of the options.", "type": "string" }
					},
					"additionalProperties": false
				},
				{
					"required": ["options"],
					"properties": {
						"id": { "$ref": "#/$defs/rowId" },
						"group": { "$ref": "#/$defs/line40" },
						"label": { "$ref": "#/$defs/line60" },
						"hint": { "$ref": "#/$defs/line200" },
						"first": { "type": "boolean" },
						"type": { "const": "select" },
						"options": { "type": "array", "minItems": 2, "maxItems": 50, "items": { "$ref": "#/$defs/option" } },
						"default": { "description": "The value of one of the options.", "type": "string" }
					},
					"additionalProperties": false
				},
				{
					"required": ["min", "max"],
					"properties": {
						"id": { "$ref": "#/$defs/rowId" },
						"group": { "$ref": "#/$defs/line40" },
						"label": { "$ref": "#/$defs/line60" },
						"hint": { "$ref": "#/$defs/line200" },
						"first": { "type": "boolean" },
						"type": { "const": "number" },
						"min": { "type": "integer" },
						"max": { "type": "integer" },
						"offer": {
							"description": "1 to 10 values offered behind the chevron, between min and max.",
							"type": "array",
							"minItems": 1,
							"maxItems": 10,
							"items": { "type": "integer" }
						},
						"default": { "description": "A whole number between min and max.", "type": "integer" }
					},
					"additionalProperties": false
				},
				{
					"properties": {
						"id": { "$ref": "#/$defs/rowId" },
						"group": { "$ref": "#/$defs/line40" },
						"label": { "$ref": "#/$defs/line60" },
						"hint": { "$ref": "#/$defs/line200" },
						"first": { "type": "boolean" },
						"type": { "const": "text" },
						"default": { "type": "string", "maxLength": 200, "pattern": "^[^\\p{Cc}\\p{Cf}\\p{Cs}\\p{Co}]*$" }
					},
					"additionalProperties": false
				}
			]
		}
	}
}
